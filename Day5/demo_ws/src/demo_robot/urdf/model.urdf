<?xml version="1.0"?>
<!-- http://wiki.ros.org/urdf/XML/link -->
<robot name="simple_robot">
	<link name="base_link">
		<visual>
			<geometry>
				<cylinder length="0.1" radius="0.2"/>
			</geometry>
			<origin rpy="0 0 0" xyz="0 0 0"/>
			<material name="Red">
				<color rgba="1 0 0 1"/>
			</material>
		</visual>
	</link>

	<joint name="joint_1" type="continuous">
		<parent link="base_link"/>
		<child link="first_link"/>
		<origin rpy="0 0 0" xyz="0.5 0.5 0" />
		<axis xyz="0 0 1"/>
		<limit effort="300" velocity="2.0" />
	</joint>

	<link name="first_link">
		<visual>
			<geometry>
				<box size="0.3 0.3 0.1"/>
			</geometry>
			<origin rpy="0 0 0" xyz="0 0 0" />
			<material name="Blue">
				<color rgba="0 0 1 1"/>
			</material>
		</visual>
	</link>

	<joint name="joint_2" type="continuous">
		<parent link="base_link"/>
		<child link="second_link"/>
		<origin rpy="0 0 0" xyz="0.5 -0.5 0" />
		<axis xyz="0 0 1"/>
		<limit effort="300" velocity="2.0" />
	</joint>

	<link name="second_link">
		<visual>
			<geometry>
				<box size="0.3 0.3 0.1"/>
			</geometry>
			<origin rpy="0 0 0" xyz="0 0 0" />
			<material name="Green">
				<color rgba="0 1 0 1"/>
			</material>
		</visual>
	</link>
		
</robot>
